generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
}

enum PaymentMethod {
  CASH
  LOCAL_TRANSFER
  CARD
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PAID
  CUSTOMER_CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
  /** Deposit captured; balance still owed. */
  DEPOSIT_PAID
  /** Balance charge scheduled / due. */
  BALANCE_DUE
  /** Off-session balance charge failed (dunning). */
  BALANCE_FAILED
}

enum ReceiptChannel {
  NONE
  EMAIL
}

enum SubStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum InventorySource {
  OWNER_MANUAL
  ORDER_CASH
  ORDER_LOCAL_TRANSFER
  ORDER_CARD
  ORDER_PAYPAL
  SYSTEM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  NONE
}

enum GalleryStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum GallerySource {
  ADMIN
  OWNER_SUBMIT
}

enum CollectionStatus {
  ORDERED
  READY
  COLLECTED
}

/** When money moves relative to goods. */
enum PaymentTiming {
  PAY_NOW
  PAY_UPFRONT
  DEPOSIT_THEN_BALANCE
}

/** How goods reach the buyer. */
enum HandoverMode {
  COLLECT
  DELIVER
}

enum FulfilmentOptionKind {
  STAND_IMMEDIATE
  PICKUP
  DELIVERY
  PREORDER_SHEET
  MENU_SHEET
  SUBSCRIPTION
}

enum MenuKind {
  /** Curated take-now list — uses stand / shop fulfilment as today. */
  ALWAYS_AVAILABLE
  /** Scheduled drop — syncs pre-order schedule to linked products. */
  PREORDER_DROP
}

enum PickupLocationType {
  HOME
  FARM_STAND
  FARM_GATE
  MARKET
  SHOP
  OTHER
}

enum PickupWindowRecurrence {
  ONE_OFF
  WEEKLY
}

enum DeliveryZoneRuleKind {
  POSTCODE
  SUBURB
}

enum FulfilmentStatus {
  NEW
  PREPARING
  READY
  COLLECTED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CartMode {
  PRODUCT
  CUSTOMER_CHOICE
}

/** Cadence for owner-built shopper subscriptions (Connect Billing). */
enum ShopperSubInterval {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ShopperSubStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(OWNER)
  accounts      Account[]
  sessions      Session[]
  owner         Owner?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/** Pending name from frictionless signup until OTP creates the User */
model SignupIntent {
  email       String   @id
  name        String
  /** Free for Life invite token, if signing up via /invite/[token] */
  inviteToken String?
  /** Meta/Google click ids + UTMs captured at signup (fbclid etc). */
  adAttribution Json?
  createdAt   DateTime @default(now())
}

/** Free for Life invite links (admin-created). maxUses=1 for DMs, higher for group posts. */
model LifetimeInvite {
  id          String                     @id @default(cuid())
  token       String                     @unique
  note        String?
  maxUses     Int                        @default(1)
  useCount    Int                        @default(0)
  createdAt   DateTime                   @default(now())
  redemptions LifetimeInviteRedemption[]
}

model LifetimeInviteRedemption {
  id        String         @id @default(cuid())
  inviteId  String
  invite    LifetimeInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  email     String
  userId    String?
  createdAt DateTime       @default(now())

  @@unique([inviteId, email])
  @@index([inviteId])
}

/** Card / PayPal plan interest from landing waitlist */
model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  plan      String   @default("card_paypal")
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Owner {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName              String
  contactEmail              String
  contactPhone              String?
  stripeAccountId           String?
  stripeOnboardingComplete  Boolean            @default(false)
  stripeChargesEnabled      Boolean            @default(false)
  stripePayoutsEnabled      Boolean            @default(false)
  /** When Connect account id was first saved (onboarding started). */
  stripeConnectStartedAt    DateTime?
  /** Email: started Connect but charges still disabled (restricted / incomplete). */
  stripeRestrictedNudgeSentAt DateTime?
  /** Email: stand set up but Stripe never connected (optional card nudge). */
  stripeNeverStartedNudgeSentAt DateTime?
  /** Platform Billing customer (Vendl SaaS subscription) */
  stripeCustomerId          String?
  /** Platform Billing subscription id */
  stripeSubscriptionId      String?
  paypalMerchantId          String?
  paypalOnboardingComplete  Boolean            @default(false)
  paypalPaymentsEnabled     Boolean            @default(false)
  emailAlertsEnabled        Boolean            @default(true)
  pushAlertsEnabled         Boolean            @default(true)
  alertEmails               String[]           @default([])
  subscriptionStatus        SubscriptionStatus @default(NONE)
  /** free | pro | pro_paypal - legacy starter/cash/card values accepted. */
  subscriptionPlan          String?            @default("free")
  /** Free Pro forever (invite or admin grant). */
  lifetimeAccess            Boolean            @default(false)
  monthlyFeeCents           Int                @default(0)
  /** Free plan: pass Vendl card fee to customer (default absorb). */
  passFeeToCustomer         Boolean            @default(false)
  /** Currency of the SaaS subscription (AUD/USD/GBP/EUR) */
  billingCurrency           String             @default("AUD")
  /** Sum of paid SaaS invoices (platform Billing), in invoice currency units */
  lifetimePaidCents         Int                @default(0)
  subscriptionStartedAt     DateTime?
  /** App-managed trial end (no card until they subscribe) */
  trialEndsAt               DateTime?
  /** Day 30 trial-ended email (lifecycle sequence) */
  trialReminderSentAt       DateTime?
  trialWelcomeSentAt        DateTime?
  /** Personal note from Jono, 3 days after signup. */
  creatorDay3SentAt         DateTime?
  trialDay7SentAt           DateTime?
  trialDay14SentAt          DateTime?
  trialDay23SentAt          DateTime?
  trialDay28SentAt          DateTime?
  trialDay45SentAt          DateTime?
  /** When paid Pro last fully lapsed to Starter (anchor for lapse emails). */
  proLapsedAt               DateTime?
  /** Pro cancel/lapse sequence (day 0 / 23 / 45). */
  proLapseDay0SentAt        DateTime?
  proLapseDay23SentAt       DateTime?
  proLapseDay45SentAt       DateTime?
  cashWelcomeSentAt         DateTime?
  cashSubscribedAt          DateTime?
  cashUpgradeDay2SentAt     DateTime?
  cashUpgradeDay7SentAt     DateTime?
  cashUpgradeDay14SentAt    DateTime?
  /** Pro welcome after paid subscribe (legacy name cardWelcomeSentAt). */
  cardWelcomeSentAt         DateTime?
  firstTenOrdersEmailSentAt DateTime?
  /** Cancellation / leave feedback email (portal cancel or delete). */
  cancelFeedbackSentAt      DateTime?
  /** Access continues until this time after cancel-at-period-end */
  currentPeriodEndsAt       DateTime?
  cancelAtPeriodEnd         Boolean            @default(false)
  platformFeePercentBps     Int                @default(200)
  stands                    Stand[]
  products                  Product[]
  categories                Category[]
  customers                 Customer[]
  storefront                Storefront?
  preOrderPages             PreOrderPage[]
  menus                     Menu[]
  subscriptionOffers        SubscriptionOffer[]
  shopperSubscriptions      ShopperSubscription[]
  orders                    Order[]
  inventoryAdjustments      InventoryAdjustment[]
  lowStockAlerts            LowStockAlert[]
  pushDevices               PushDevice[]
  galleryStands             GalleryStand[]
  notifications             Notification[]
  pickupLocations           PickupLocation[]
  pickupWindows             PickupWindow[]
  deliveryZones             DeliveryZone[]
  fulfilmentOptions         FulfilmentOption[]
  ingredients               Ingredient[]
  recipes                   Recipe[]
  productionPlans           ProductionPlan[]
  customerTags              CustomerTag[]
  customerSegments          CustomerSegment[]
  promotions                Promotion[]
  campaigns                 Campaign[]
  marketingSuppressions     MarketingSuppression[]
  loyaltyProgram            LoyaltyProgram?
  reviews                   Review[]
  giftCards                 GiftCard[]
  customOrderForms          CustomOrderForm[]
  customOrderRequests       CustomOrderRequest[]
  sellerEvents              SellerEvent[]
  /** Soft-close: data retained, login/emails/stands stopped. */
  deletedAt                 DateTime?
  /** Ad click ids + UTMs from first signup (for Perform/Meta pushback). */
  adAttribution             Json?
  /** First catalogue product went live (signup→live timing). */
  firstProductLiveAt        DateTime?
  /** Stall→pre-orders contextual cross-sell dismissed. */
  preOrdersCrossSellDismissedAt DateTime?
  /**
   * Onboarding preset: FARM_STAND | FOOD_BUSINESS | BOTH.
   * Configures checklist/nav emphasis only — not a separate account type.
   */
  businessMode              String?
  /** ISO country; AU-first onboarding defaults here. */
  country                   String             @default("AU")
  stateTerritory            String?
  suburb                    String?
  postcode                  String?
  abn                       String?
  gstRegistered             Boolean            @default(false)
  pricesIncludeGst          Boolean            @default(true)
  shortDescription          String?
  /** Multi-select sell categories from onboarding (eggs, bread, …). */
  sellCategories            String[]           @default([])
  /** Intents: farm_stand | pickup | delivery | preorders | subscriptions */
  fulfilmentIntents         String[]           @default([])
  /** Null until guided setup finished or skipped (legacy backfilled). */
  onboardingCompletedAt     DateTime?
  /** Brand defaults applied to first stand during onboarding theme step. */
  brandAccentColor          String?
  brandSecondaryColor       String?
  brandLogoUrl              String?
  defaultTimezone           String             @default("Australia/Adelaide")
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([deletedAt])
}

/** Public stand gallery - admin-curated + owner submissions */
model GalleryStand {
  id          String        @id @default(cuid())
  displayName String
  location    String
  imageUrl    String
  caption     String?
  source      GallerySource
  status      GalleryStatus @default(PENDING)
  sortOrder   Int           @default(100)
  ownerId     String?
  owner       Owner?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  standId     String?
  consentAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model PushDevice {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Stand {
  id                 String               @id @default(cuid())
  ownerId            String
  owner              Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  slug               String               @unique
  description        String?
  locationLabel      String?
  qrSignMessage      String?
  qrCallout          String?
  currency           String               @default("AUD")
  /** IANA timezone for order-by / collection wall-clock times. */
  timezone           String               @default("Australia/Adelaide")
  /** PayID / Pix / UPI alias shown at checkout (owner-direct; not verified). */
  localTransferAlias String?
  localTransferMethodId String?
  /** Per-stand checkout method toggles (still need owner Connect for card/PayPal). */
  acceptCash         Boolean              @default(true)
  acceptLocalTransfer Boolean             @default(true)
  acceptCard         Boolean              @default(true)
  acceptPayPal       Boolean              @default(false)
  showExactStock     Boolean              @default(false)
  /** Show “Only N left” when stock ≤ lowStockThreshold (public). */
  showPublicScarcity Boolean              @default(true)
  isActive           Boolean              @default(true)
  /** PRODUCT = catalog cart (default); CUSTOMER_CHOICE = open dollar amount. */
  cartMode           CartMode             @default(PRODUCT)
  /** Hidden sentinel product for Customer Choice checkout lines. */
  customerChoiceProductId String?
  /** Stand-level cart upsell product (optional) - take-now carts. */
  upsellProductId    String?
  /** Optional override price when added via upsell card. */
  upsellPriceCents   Int?
  /** Pre-order cart add-on (name + price); linked hidden product. */
  preOrderUpsellName String?
  preOrderUpsellPriceCents Int?
  /** PERCENT | AMOUNT - off the list price for customer display. */
  preOrderUpsellDiscountKind String?
  /** Percent 1–100, or cents off when AMOUNT. */
  preOrderUpsellDiscountValue Int?
  preOrderUpsellProductId String?
  firstOrderDiscountEnabled Boolean        @default(false)
  /** Percent off first order (used when amount cents unset). */
  firstOrderDiscountPercent Int            @default(10)
  /** Fixed amount off; if set, wins over percent. */
  firstOrderDiscountAmountCents Int?
  posterShowCta      Boolean              @default(true)
  posterCtaText      String?
  posterShowBundles  Boolean              @default(true)
  posterShowFirstOrder Boolean            @default(true)
  posterShowInstructions Boolean          @default(true)
  posterShowFreshness Boolean             @default(false)
  posterShowHowItWorks Boolean            @default(false)
  /** Owner logo for public stall + QR poster (Pro). */
  logoUrl            String?
  /** Hex accent e.g. #2e7d3f - overrides --leaf on public stall + QR. */
  accentColor        String?
  /** Hex secondary for prices / stock labels - overrides --ok. */
  secondaryColor     String?
  /** Optional social / website links shown on the public stall (Pro). */
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  youtubeUrl         String?
  websiteUrl         String?
  /** Vertical config key: bakers | farm-stalls | firewood | … */
  verticalSlug       String?
  products           Product[]
  productChannels    ProductChannel[]
  preOrderPages      PreOrderPage[]
  menus              Menu[]
  subscriptionOffers SubscriptionOffer[]
  shopperSubscriptions ShopperSubscription[]
  orders             Order[]
  inventoryAdjustments InventoryAdjustment[]
  lowStockAlerts     LowStockAlert[]
  restockSubscribers RestockSubscriber[]
  restockNotifications RestockNotification[]
  cardInterests      CardInterest[]
  channelInterests   ChannelInterest[]
  notifications      Notification[]
  fulfilmentOptions  FulfilmentOption[]
  pickupLocations    PickupLocation[]
  sellerEvents       SellerEvent[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([ownerId])
}

/** Owner catalogue taxonomy (not onboarding sellCategories tips). */
model Category {
  id          String             @id @default(cuid())
  ownerId     String
  owner       Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  products    ProductCategory[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId, sortOrder])
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@unique([productId, categoryId])
  @@index([categoryId])
}

enum ProductChannelType {
  STAND
  ONLINE
}

/**
 * Where a catalogue product is sold.
 * STAND/ONLINE always carry standId (ONLINE → primary public /s slug for now).
 * Pre-order / subscription membership stays on existing junction tables.
 */
model ProductChannel {
  id          String             @id @default(cuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  channelType ProductChannelType
  standId     String
  stand       Stand              @relation(fields: [standId], references: [id], onDelete: Cascade)
  isEnabled   Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([productId, channelType, standId])
  @@index([standId, channelType, isEnabled])
  @@index([productId])
}

/** Lightweight CRM — only created when an email exists (never for cash anonymity). */
model Customer {
  id                   String                 @id @default(cuid())
  ownerId              String
  owner                Owner                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /** Normalised lowercase email when known. */
  email                String?
  name                 String?
  phone                String?
  notes                String?
  marketingConsent     Boolean                @default(false)
  marketingConsentAt   DateTime?
  /** First-seen channel hint e.g. order | subscription | restock */
  source               String?
  orders               Order[]
  shopperSubscriptions ShopperSubscription[]
  restockSubscribers   RestockSubscriber[]
  tagLinks             CustomerTagLink[]
  loyaltyAccount       LoyaltyAccount?
  reviews              Review[]
  campaignRecipients   CampaignRecipient[]
  giftCardsIssued      GiftCard[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([ownerId, email])
  @@index([ownerId, createdAt])
}

/** Owner online shop at /shop/{slug} — separate from farm-stand QR URLs. */
model Storefront {
  id              String    @id @default(cuid())
  ownerId         String    @unique
  owner           Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /** Public path segment: vendl.app/shop/{slug} */
  slug            String    @unique
  isPublished     Boolean   @default(false)
  headline        String?
  subheadline     String?
  about           String?
  heroImageUrl    String?
  themePreset     String    @default("market")
  /** Working copy — saved on “Save draft”. */
  draftConfig     Json      @default("{}")
  /** Snapshot copied from draft on publish. */
  publishedConfig Json?
  publishedAt     DateTime?
  contactEmail    String?
  showPhone       Boolean   @default(false)
  /** Legacy single field; prefer StorefrontDomain rows (Phase 9). */
  customDomain    String?
  domains         StorefrontDomain[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished])
}

enum StorefrontDomainType {
  VENDL_SUBDOMAIN
  CUSTOM
}

enum StorefrontDomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  ERROR
  DISCONNECTED
}

/** Phase 9 — hostname → storefront mapping (Vendl subdomain or Cloudflare custom hostname). */
model StorefrontDomain {
  id                         String                 @id @default(cuid())
  storefrontId               String
  storefront                 Storefront             @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  /** Normalized hostname only (no scheme/path/port). */
  hostname                   String                 @unique
  type                       StorefrontDomainType
  status                     StorefrontDomainStatus @default(PENDING)
  isPrimary                  Boolean                @default(false)
  cloudflareCustomHostnameId String?
  hostnameStatus             String?
  sslStatus                  String?
  verificationMethod         String?
  verificationName           String?
  verificationValue          String?
  cnameTarget                String?
  lastCheckedAt              DateTime?
  verifiedAt                 DateTime?
  activatedAt                DateTime?
  errorCode                  String?
  errorMessage               String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([storefrontId, status])
  @@index([storefrontId, isPrimary])
  @@index([type, status])
}

// --- Phase 5: reusable fulfilment ---

model PickupLocation {
  id                            String             @id @default(cuid())
  ownerId                       String
  owner                         Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  standId                       String?
  stand                         Stand?             @relation(fields: [standId], references: [id], onDelete: SetNull)
  type                          PickupLocationType @default(OTHER)
  name                          String
  publicLabel                   String
  addressLine1                  String?
  suburb                        String?
  stateTerritory                String?
  postcode                      String?
  latitude                      Float?
  longitude                     Float?
  publicInstructions            String?
  privateInstructions           String?
  showFullAddressBeforePurchase Boolean            @default(false)
  isActive                      Boolean            @default(true)
  sortOrder                     Int                @default(0)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  windows                       PickupWindow[]
  fulfilmentOptions             FulfilmentOption[]

  @@index([ownerId, isActive, sortOrder])
}

model PickupWindow {
  id                String                 @id @default(cuid())
  ownerId           String
  owner             Owner                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pickupLocationId  String?
  pickupLocation    PickupLocation?        @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  label             String?
  timezone          String                 @default("Australia/Adelaide")
  recurrence        PickupWindowRecurrence @default(WEEKLY)
  startsAt          DateTime?
  endsAt            DateTime?
  weekday           Int?
  startTimeMin      Int?
  endTimeMin        Int?
  orderOpensAt      DateTime?
  orderClosesAt     DateTime?
  orderOpenWeekday  Int?
  orderOpenTimeMin  Int?
  orderCloseWeekday Int?
  orderCloseTimeMin Int?
  maxOrders         Int?
  pickupFeeCents    Int                    @default(0)
  minOrderCents     Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  fulfilmentOptions FulfilmentOption[]

  @@index([ownerId, isActive])
}

model DeliveryZone {
  id                   String             @id @default(cuid())
  ownerId              String
  owner                Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  deliveryFeeCents     Int                @default(0)
  freeDeliveryMinCents Int?
  minOrderCents        Int                @default(0)
  timezone             String             @default("Australia/Adelaide")
  recurrence           PickupWindowRecurrence @default(WEEKLY)
  weekday              Int?
  startTimeMin         Int?
  endTimeMin           Int?
  orderCloseWeekday    Int?
  orderCloseTimeMin    Int?
  customerInstructions String?
  isActive             Boolean            @default(true)
  sortOrder            Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  rules                DeliveryZoneRule[]
  fulfilmentOptions    FulfilmentOption[]

  @@index([ownerId, isActive, sortOrder])
}

model DeliveryZoneRule {
  id             String              @id @default(cuid())
  deliveryZoneId String
  deliveryZone   DeliveryZone        @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  kind           DeliveryZoneRuleKind
  value          String

  @@unique([deliveryZoneId, kind, value])
}

model FulfilmentOption {
  id                  String               @id @default(cuid())
  ownerId             String
  owner               Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind                FulfilmentOptionKind
  label               String
  standId             String?
  stand               Stand?               @relation(fields: [standId], references: [id], onDelete: Cascade)
  pickupLocationId    String?
  pickupLocation      PickupLocation?      @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  pickupWindowId      String?
  pickupWindow        PickupWindow?        @relation(fields: [pickupWindowId], references: [id], onDelete: SetNull)
  deliveryZoneId      String?
  deliveryZone        DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  preOrderPageId      String?              @unique
  preOrderPage        PreOrderPage?        @relation(fields: [preOrderPageId], references: [id], onDelete: SetNull)
  menuId              String?              @unique
  menu                Menu?                @relation(fields: [menuId], references: [id], onDelete: SetNull)
  subscriptionOfferId String?              @unique
  subscriptionOffer   SubscriptionOffer?   @relation(fields: [subscriptionOfferId], references: [id], onDelete: SetNull)
  handoverMode        HandoverMode         @default(COLLECT)
  paymentTiming       PaymentTiming        @default(PAY_NOW)
  depositPercent      Int?
  minOrderCents       Int                  @default(0)
  feeCents            Int                  @default(0)
  /** STAND | ONLINE — which channels surface this option. */
  channels            String[]             @default(["STAND"])
  isActive            Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  products            ProductFulfilmentOption[]
  orderSnapshots      OrderFulfilment[]

  @@index([ownerId, kind, isActive, sortOrder])
  @@index([standId])
}

model ProductFulfilmentOption {
  id                 String           @id @default(cuid())
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  fulfilmentOptionId String
  fulfilmentOption   FulfilmentOption @relation(fields: [fulfilmentOptionId], references: [id], onDelete: Cascade)
  isEnabled          Boolean          @default(true)

  @@unique([productId, fulfilmentOptionId])
  @@index([fulfilmentOptionId])
}

model OrderFulfilment {
  id                        String               @id @default(cuid())
  orderId                   String               @unique
  order                     Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfilmentOptionId        String?
  fulfilmentOption          FulfilmentOption?    @relation(fields: [fulfilmentOptionId], references: [id], onDelete: SetNull)
  kind                      FulfilmentOptionKind
  optionLabel               String
  pickupLocationName        String?
  pickupPublicLabel         String?
  pickupAddressSnapshot     String?
  pickupInstructions        String?
  pickupPrivateInstructions String?
  windowLabel               String?
  collectionStartsAt        DateTime?
  collectionEndsAt          DateTime?
  deliveryZoneName          String?
  deliveryFeeCents          Int                  @default(0)
  handoverMode              HandoverMode
  fulfilmentStatus          FulfilmentStatus     @default(NEW)
  sellerNotes               String?
  createdAt                 DateTime             @default(now())

  @@index([collectionStartsAt, fulfilmentStatus])
  @@index([fulfilmentOptionId])
}

/** Starter checkout: shopper tapped "I'd have paid by card" (no PII). */
model CardInterest {
  id            String   @id @default(cuid())
  standId       String
  stand         Stand    @relation(fields: [standId], references: [id], onDelete: Cascade)
  subtotalCents Int
  currency      String
  createdAt     DateTime @default(now())

  @@index([standId, createdAt])
}

enum ChannelInterestKind {
  PREORDER
  SUBSCRIPTION
}

/** Shopper asked the stall to offer pre-orders or subscriptions. */
model ChannelInterest {
  id        String               @id @default(cuid())
  standId   String
  stand     Stand                @relation(fields: [standId], references: [id], onDelete: Cascade)
  kind      ChannelInterestKind
  email     String
  createdAt DateTime             @default(now())

  @@unique([standId, kind, email])
  @@index([standId, createdAt])
}

model Product {
  id                 String               @id @default(cuid())
  standId            String
  stand              Stand                @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  /** URL segment under /s/{standSlug}/{slug}; unique per stand. */
  slug               String
  description        String?
  imageUrl           String?
  seoTitle           String?
  seoDescription     String?
  priceCents         Int
  /** Owner-only unit cost; profit = priceCents - costCents when set. */
  costCents          Int?
  /** Owner-only stock-keeping unit. */
  sku                String?
  /** Owner-only barcode / UPC. */
  upc                String?
  currency           String               @default("AUD")
  stockQuantity      Int                  @default(0)
  lowStockThreshold  Int                  @default(5)
  /** Legacy soft-off; kept in sync with isArchived for older queries. */
  isActive           Boolean              @default(true)
  /** Hidden from stand catalog; direct link + checkout still work. */
  isHidden           Boolean              @default(false)
  /** Archived from selling; restorable. Not shown publicly. */
  isArchived         Boolean              @default(false)
  sortOrder          Int                  @default(0)
  /** Card-tier pay-upfront pre-order; stockQuantity is the cap. Synced from pre-order pages. */
  isPreOrder         Boolean              @default(false)
  /** Owner opted this catalogue product into pre-order pages. */
  preOrderEligible   Boolean              @default(false)
  orderByAt          DateTime?
  collectionAt       DateTime?
  collectionNote     String?
  /** When pre-order: show remaining slots publicly (e.g. "3 left"). */
  showExactStock     Boolean              @default(false)
  /** Defaults for new pre-order checkouts from this product. */
  paymentTiming      PaymentTiming        @default(PAY_NOW)
  /** 1–99 when paymentTiming is DEPOSIT_THEN_BALANCE. */
  depositPercent     Int?
  handoverMode       HandoverMode         @default(COLLECT)
  /** Optional provenance line e.g. "Laid this morning". */
  freshnessNote      String?
  /** Cart upsell offered when this product is in the cart (overrides stand-level). */
  upsellProductId    String?
  /** Optional override price when added via this product's upsell. */
  upsellPriceCents   Int?
  /** Pre-order add-on for carts that include this product. */
  preOrderUpsellName String?
  preOrderUpsellPriceCents Int?
  preOrderUpsellDiscountKind String?
  preOrderUpsellDiscountValue Int?
  preOrderUpsellProductId String?
  /** Exact-qty totals: [{ "qty": 2, "totalCents": 900 }, ...] — XOR with optionGroups. */
  priceTiers         Json?
  optionGroups       ProductOptionGroup[]
  categoryLinks      ProductCategory[]
  channels           ProductChannel[]
  preOrderPageItems  PreOrderPageProduct[]
  menuItems          MenuProduct[]
  subscriptionOfferItems SubscriptionOfferProduct[]
  fulfilmentOptions      ProductFulfilmentOption[]
  /** Optional link to a production recipe (Phase 6). */
  productRecipe      ProductRecipe?
  /** Optional packaging/materials cost per sellable unit (cents). */
  packagingCostCents Int?
  orderItems         OrderItem[]
  inventoryAdjustments InventoryAdjustment[]
  lowStockAlerts     LowStockAlert[]
  eventProducts      SellerEventProduct[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([standId, slug])
  @@index([standId, isActive])
  @@index([ownerId])
}

/** Recurring box / membership basket built from catalog products. */
model SubscriptionOffer {
  id                 String                     @id @default(cuid())
  standId            String
  stand              Stand                      @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              Owner                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title              String
  slug               String
  description        String?
  isActive           Boolean                    @default(true)
  interval           ShopperSubInterval         @default(WEEKLY)
  handoverMode       HandoverMode               @default(COLLECT)
  /** 0=Sun … 6=Sat; next collection weekday for COLLECT. */
  collectionWeekday  Int?
  collectionNote     String?
  /** Snapshot total of line prices (qty × product.priceCents). */
  priceCents         Int
  currency           String                     @default("AUD")
  /** Stripe Product on the connected account. */
  stripeProductId    String?
  /** Stripe Price on the connected account (recurring). */
  stripePriceId      String?
  items              SubscriptionOfferProduct[]
  subscriptions      ShopperSubscription[]
  fulfilmentOption   FulfilmentOption?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([standId, slug])
  @@index([standId, isActive])
}

model SubscriptionOfferProduct {
  id                 String            @id @default(cuid())
  subscriptionOfferId String
  subscriptionOffer  SubscriptionOffer @relation(fields: [subscriptionOfferId], references: [id], onDelete: Cascade)
  productId          String
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity           Int               @default(1)
  sortOrder          Int               @default(0)

  @@unique([subscriptionOfferId, productId])
  @@index([productId])
}

/** Shopper enrolled in an offer; Stripe Customer/Sub live on Connect account. */
model ShopperSubscription {
  id                     String            @id @default(cuid())
  offerId                String
  offer                  SubscriptionOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  standId                String
  stand                  Stand             @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId                String
  owner                  Owner             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status                 ShopperSubStatus  @default(INCOMPLETE)
  customerName           String
  customerEmail          String
  customerPhone          String?
  customerId             String?
  customer               Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryAddressLine1   String?
  deliverySuburb         String?
  deliveryPostcode       String?
  deliveryNotes          String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  /** Opaque token for manage / portal / skip / pause links. */
  manageToken            String            @unique
  skipNextCycle          Boolean           @default(false)
  pausedAt               DateTime?
  cancelAtPeriodEnd      Boolean           @default(false)
  currentPeriodEndsAt    DateTime?
  nextCollectionAt       DateTime?
  orders                 Order[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([stripeSubscriptionId])
  @@index([standId, status])
  @@index([ownerId, createdAt])
  @@index([offerId])
  @@index([customerId])
}

/** Multi-product pre-order sheet: one link, shared collection day. */
model PreOrderPage {
  id               String               @id @default(cuid())
  standId          String
  stand            Stand                @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  slug             String
  description      String?
  /** Optional cover used for social link previews (Open Graph). */
  imageUrl         String?
  isActive         Boolean              @default(true)
  /** When true, page products stay off the business catalog and business QR. */
  hideOnBusinessPage Boolean            @default(true)
  orderByAt        DateTime
  collectionAt     DateTime
  collectionNote   String?
  showExactStock   Boolean              @default(false)
  paymentTiming    PaymentTiming        @default(PAY_UPFRONT)
  depositPercent   Int?
  handoverMode     HandoverMode         @default(COLLECT)
  /** Page-level cart add-on for this pre-order sheet. */
  preOrderUpsellName String?
  preOrderUpsellPriceCents Int?
  preOrderUpsellDiscountKind String?
  preOrderUpsellDiscountValue Int?
  preOrderUpsellProductId String?
  items            PreOrderPageProduct[]
  fulfilmentOption FulfilmentOption?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([standId, slug])
  @@index([standId, isActive])
}

model PreOrderPageProduct {
  id             String       @id @default(cuid())
  preOrderPageId String
  preOrderPage   PreOrderPage @relation(fields: [preOrderPageId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)

  @@unique([preOrderPageId, productId])
  @@index([productId])
}

/** Curated product list — always-on menu or scheduled pre-order drop. */
model Menu {
  id                 String        @id @default(cuid())
  standId            String
  stand              Stand         @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title              String
  slug               String
  description        String?
  isActive           Boolean       @default(true)
  kind               MenuKind      @default(ALWAYS_AVAILABLE)
  /** When true, menu products stay off the stand catalog / QR grid. */
  hideOnBusinessPage Boolean       @default(false)
  showOnStand        Boolean       @default(true)
  showOnShop         Boolean       @default(true)
  /** PREORDER_DROP schedule (null for ALWAYS_AVAILABLE). */
  orderByAt          DateTime?
  collectionAt       DateTime?
  collectionNote     String?
  showExactStock     Boolean       @default(false)
  paymentTiming      PaymentTiming @default(PAY_UPFRONT)
  depositPercent     Int?
  handoverMode       HandoverMode  @default(COLLECT)
  items              MenuProduct[]
  fulfilmentOption   FulfilmentOption?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([standId, slug])
  @@index([standId, isActive, kind])
}

model MenuProduct {
  id        String  @id @default(cuid())
  menuId    String
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@unique([menuId, productId])
  @@index([productId])
}

/** Named option group on a product (e.g. Size, Flavour). Max 3 per product in app. */
model ProductOptionGroup {
  id        String                @id @default(cuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int                   @default(0)
  choices   ProductOptionChoice[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([productId, sortOrder])
}

model ProductOptionChoice {
  id              String             @id @default(cuid())
  groupId         String
  group           ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  /** Added to product base price (can be 0 or positive). */
  priceDeltaCents Int                @default(0)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([groupId, sortOrder])
}

model Order {
  id                      String            @id @default(cuid())
  standId                 String
  stand                   Stand             @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId                 String
  owner                   Owner             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orderNumber             String            @unique
  paymentMethod           PaymentMethod
  paymentStatus           PaymentStatus
  /** payid | pix | upi when paymentMethod is LOCAL_TRANSFER */
  localTransferMethodId   String?
  subtotalCents           Int
  totalCents              Int
  /** First-order (or other) discount applied to this order. */
  discountCents           Int               @default(0)
  discountLabel           String?
  /** Phase 7 promotion used (nullable; label/code snapshotted). */
  promotionId             String?
  promotion               Promotion?        @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionCodeSnapshot   String?
  /** Campaign attribution (first-party click → order within window). */
  campaignId              String?
  campaign                Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  currency                String
  platformFeeCents        Int               @default(0)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paypalOrderId           String?
  paypalCaptureId         String?
  receiptEmail            String?
  receiptChannel          ReceiptChannel    @default(NONE)
  customerId              String?
  customer                Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  isPreOrder              Boolean           @default(false)
  collectionAt            DateTime?
  collectionNote          String?
  customerName            String?
  customerPhone           String?
  collectionStatus        CollectionStatus?
  paymentTiming           PaymentTiming     @default(PAY_NOW)
  handoverMode            HandoverMode      @default(COLLECT)
  /** Amount charged as deposit (cents). */
  depositCents            Int?
  /** Remaining balance owed (cents). */
  balanceCents            Int?
  /** When to charge the balance (usually delivery/collection day). */
  balanceDueAt            DateTime?
  /** Saved card on connected account for off-session balance. */
  stripePaymentMethodId   String?
  balancePaymentIntentId  String?
  /** Off-session balance charge attempts (dunning). */
  balanceRetryCount       Int               @default(0)
  balanceLastFailedAt     DateTime?
  deliveryAddressLine1    String?
  deliverySuburb          String?
  deliveryPostcode        String?
  deliveryNotes           String?
  /** Set when this order was created from a shopper subscription invoice. */
  shopperSubscriptionId   String?
  shopperSubscription     ShopperSubscription? @relation(fields: [shopperSubscriptionId], references: [id], onDelete: SetNull)
  /** Connect invoice id — idempotency for subscription cycle orders. */
  stripeInvoiceId         String?           @unique
  items                   OrderItem[]
  inventoryAdjustments    InventoryAdjustment[]
  fulfilment              OrderFulfilment?
  /** Opaque QR lookup token for seller handover (Phase 8). */
  opsLookupToken          String?           @unique
  /** Market/event sale link (nullable). */
  sellerEventId           String?
  sellerEvent             SellerEvent?      @relation(fields: [sellerEventId], references: [id], onDelete: SetNull)
  /** Converted from a custom order request. */
  customOrderRequestId    String?           @unique
  customOrderRequest      CustomOrderRequest? @relation(fields: [customOrderRequestId], references: [id], onDelete: SetNull)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([ownerId, createdAt])
  @@index([standId, createdAt])
  @@index([standId, collectionAt, collectionStatus])
  @@index([paymentStatus, balanceDueAt])
  @@index([shopperSubscriptionId])
  @@index([customerId])
  @@index([promotionId])
  @@index([campaignId])
  @@index([sellerEventId])
}

model OrderItem {
  id                  String    @id @default(cuid())
  orderId             String
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product   @relation(fields: [productId], references: [id])
  productNameSnapshot String
  /** e.g. "Size: Dozen · Flavour: Chocolate" */
  optionsSnapshot     String?
  quantity            Int
  unitPriceCents      Int
  lineTotalCents      Int
  /** Phase 8 packing checkoff — set when line is packed (qty unchanged). */
  packedAt            DateTime?
  createdAt           DateTime  @default(now())

  @@index([orderId])
}

model InventoryAdjustment {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  standId          String
  stand            Stand           @relation(fields: [standId], references: [id], onDelete: Cascade)
  changeQuantity   Int
  previousQuantity Int
  newQuantity      Int
  reason           String
  source           InventorySource
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([productId, createdAt])
}

model LowStockAlert {
  id                   String   @id @default(cuid())
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ownerId              String
  owner                Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  standId              String
  stand                Stand    @relation(fields: [standId], references: [id], onDelete: Cascade)
  stockQuantityAtAlert Int
  threshold            Int
  channel              String   @default("email")
  sentAt               DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([productId, sentAt])
}

model RestockSubscriber {
  id             String    @id @default(cuid())
  standId        String
  stand          Stand     @relation(fields: [standId], references: [id], onDelete: Cascade)
  email          String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         SubStatus @default(ACTIVE)
  consentText    String
  consentAt      DateTime  @default(now())
  consentSource  String
  unsubToken     String    @unique
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([standId, email])
  @@index([standId, status])
  @@index([customerId])
}

model RestockNotification {
  id             String   @id @default(cuid())
  standId        String
  stand          Stand    @relation(fields: [standId], references: [id], onDelete: Cascade)
  sentByUserId   String
  recipientCount Int
  sentAt         DateTime @default(now())

  @@index([standId, sentAt])
}

/** Audit log for outbound emails (Resend + local console fallback). */
model EmailSendLog {
  id        String   @id @default(cuid())
  /** Lowercased recipient addresses */
  toEmails  String[]
  subject   String
  /** e.g. otp, sale, lifecycle_welcome, restock, waitlist */
  kind      String?
  /** sent | failed | console */
  status    String
  resendId  String?
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

enum NotificationType {
  CHANNEL_INTEREST
  LOW_STOCK
  OUT_OF_STOCK
  RESTOCK
  NEW_ORDER
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_CANCELLED
  PAYMENT_FAILED
  OTHER
}

enum NotificationStatus {
  OPEN
  ACTIONED
  CLOSED
}

/** In-app notifications for business owners. */
model Notification {
  id        String             @id @default(cuid())
  ownerId   String
  owner     Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  standId   String?
  stand     Stand?             @relation(fields: [standId], references: [id], onDelete: Cascade)
  type      NotificationType
  status    NotificationStatus @default(OPEN)
  title     String
  message   String
  /** JSON metadata specific to notification type (email, productId, orderId, etc.) */
  metadata  Json?
  isRead    Boolean            @default(false)
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([ownerId, status, createdAt])
  @@index([ownerId, isRead, createdAt])
  @@index([standId, createdAt])
}

/** Canonical recipe/ingredient measure units (Phase 6). */
enum MeasureUnit {
  MG
  G
  KG
  ML
  L
  EACH
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
}

/** Owner-scoped purchasable ingredient with current buy-price. */
model Ingredient {
  id                 String                  @id @default(cuid())
  ownerId            String
  owner              Owner                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  /** Unit recipes usually reference (e.g. G for flour). */
  baseUnit           MeasureUnit
  /** How much you buy in one purchase (e.g. 12.5). */
  purchaseQuantity   Decimal                 @db.Decimal(18, 6)
  purchaseUnit       MeasureUnit
  purchasePriceCents Int
  supplier           String?
  sku                String?
  notes              String?
  isActive           Boolean                 @default(true)
  recipeLines        RecipeIngredient[]
  costHistory        IngredientCostHistory[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([ownerId, isActive])
  @@index([ownerId, name])
}

/** Snapshot when purchase price/qty changes — current costing uses Ingredient fields. */
model IngredientCostHistory {
  id                 String      @id @default(cuid())
  ingredientId       String
  ingredient         Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  purchaseQuantity   Decimal     @db.Decimal(18, 6)
  purchaseUnit       MeasureUnit
  purchasePriceCents Int
  note               String?
  recordedAt         DateTime    @default(now())

  @@index([ingredientId, recordedAt])
}

model Recipe {
  id              String             @id @default(cuid())
  ownerId         String
  owner           Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  /** How many sellable/yield units one batch produces. */
  yieldQuantity   Decimal            @db.Decimal(18, 6)
  /** Human label for yield units — e.g. "buns", "loaves", "batches". */
  yieldLabel      String             @default("units")
  instructions    String?
  prepNotes       String?
  isActive        Boolean            @default(true)
  lines           RecipeIngredient[]
  productLinks    ProductRecipe[]
  usedAsComponent RecipeIngredient[] @relation("RecipeComponent")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([ownerId, isActive])
  @@index([ownerId, name])
}

/**
 * Recipe line: either a raw Ingredient OR a nested component Recipe (XOR).
 * Nested quantity is expressed in the component recipe's yield units.
 */
model RecipeIngredient {
  id                String       @id @default(cuid())
  recipeId          String
  recipe            Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId      String?
  ingredient        Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  componentRecipeId String?
  componentRecipe   Recipe?      @relation("RecipeComponent", fields: [componentRecipeId], references: [id], onDelete: Restrict)
  quantity          Decimal      @db.Decimal(18, 6)
  /** Required for ingredient lines; ignored for component-recipe lines. */
  unit              MeasureUnit?
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([recipeId, sortOrder])
  @@index([ingredientId])
  @@index([componentRecipeId])
}

/** One primary production recipe per product. */
model ProductRecipe {
  id                   String   @id @default(cuid())
  productId            String   @unique
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipeId             String
  recipe               Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  /**
   * How many of the recipe's yield units are in one product unit.
   * Example: recipe yields 12 buns; box of 6 → yieldUnitsPerProduct = 6.
   */
  yieldUnitsPerProduct Decimal  @db.Decimal(18, 6)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([recipeId])
}

/**
 * Optional persisted notes/status for a derived production group.
 * groupKey examples: "day:2026-09-12", "menu:<id>", "fo:<fulfilmentOptionId>:2026-09-12"
 */
model ProductionPlan {
  id        String           @id @default(cuid())
  ownerId   String
  owner     Owner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  standId   String
  groupKey  String
  title     String?
  notes     String?
  status    ProductionStatus @default(PLANNED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([ownerId, groupKey])
  @@index([ownerId, standId])
}

// ─── Phase 7: Growth & Customer Retention ───────────────────────────────────

enum PromotionType {
  PERCENT_OFF
  FIXED_OFF
  FREE_DELIVERY
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoyaltyTxnType {
  ORDER_EARN
  REWARD_REDEEM
  MANUAL_ADJUSTMENT
  REFUND_REVERSAL
}

enum GiftCardTxnType {
  ISSUE
  REDEEM
  REFUND_RESTORE
  MANUAL_ADJUSTMENT
}

model CustomerTag {
  id        String            @id @default(cuid())
  ownerId   String
  owner     Owner             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  links     CustomerTagLink[]
  createdAt DateTime          @default(now())

  @@unique([ownerId, name])
  @@index([ownerId])
}

model CustomerTagLink {
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@id([customerId, tagId])
  @@index([tagId])
}

/** Dynamic segment — rules stored as JSON conditions evaluated at query time. */
model CustomerSegment {
  id          String     @id @default(cuid())
  ownerId     String
  owner       Owner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /** Preset key e.g. best_customers | custom */
  presetKey   String?
  /**
   * Conditions object, e.g.
   * { "minOrders": 2, "minSpendCents": 10000, "daysSinceLastOrderMin": 60,
   *   "tagIds": [], "productIds": [], "menuIds": [], "marketingConsent": true,
   *   "subscriptionActive": true }
   */
  rules       Json       @default("{}")
  isActive    Boolean    @default(true)
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId, isActive])
}

model Promotion {
  id                 String        @id @default(cuid())
  ownerId            String
  owner              Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  code               String
  name               String
  type               PromotionType @default(PERCENT_OFF)
  /** Percent 1–100 when PERCENT_OFF; ignored for FIXED. */
  percentOff         Int?
  /** Fixed cents off when FIXED_OFF. */
  amountOffCents     Int?
  minOrderCents      Int           @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  usageLimit         Int?
  perCustomerLimit   Int           @default(1)
  usageCount         Int           @default(0)
  /** Empty = all products. */
  productIds         String[]      @default([])
  categoryIds        String[]      @default([])
  menuIds            String[]      @default([])
  firstOrderOnly     Boolean       @default(false)
  isActive           Boolean       @default(true)
  orders             Order[]
  campaigns          Campaign[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([ownerId, code])
  @@index([ownerId, isActive])
}

model MarketingSuppression {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  email     String
  /** unsubscribed | bounce | complaint | manual */
  reason    String   @default("unsubscribed")
  token     String   @unique
  createdAt DateTime @default(now())

  @@unique([ownerId, email])
  @@index([ownerId])
}

model Campaign {
  id              String              @id @default(cuid())
  ownerId         String
  owner           Owner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  status          CampaignStatus      @default(DRAFT)
  subject         String
  previewText     String?
  heading         String?
  body            String
  imageUrl        String?
  ctaLabel        String?
  ctaUrl          String?
  segmentId       String?
  segment         CustomerSegment?    @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  promotionId     String?
  promotion       Promotion?          @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /** menu | product | custom audience hint */
  audienceType    String              @default("segment")
  audienceRefId   String?
  templateKey     String?
  sentAt          DateTime?
  recipientCount  Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  clickCount      Int                 @default(0)
  attributedOrders Int                @default(0)
  attributedRevenueCents Int          @default(0)
  recipients      CampaignRecipient[]
  clicks          CampaignClick[]
  orders          Order[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([ownerId, status])
}

model CampaignRecipient {
  id           String                   @id @default(cuid())
  campaignId   String
  campaign     Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email        String
  status       CampaignRecipientStatus  @default(PENDING)
  errorMessage String?
  resendId     String?
  sentAt       DateTime?
  createdAt    DateTime                 @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([customerId])
}

model CampaignClick {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  token      String    @unique
  email      String?
  clickedAt  DateTime  @default(now())
  orderId    String?

  @@index([campaignId, clickedAt])
}

model LoyaltyProgram {
  id                 String           @id @default(cuid())
  ownerId            String           @unique
  owner              Owner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String           @default("Rewards")
  isActive           Boolean          @default(false)
  /** Points earned per whole currency unit spent (e.g. 1 = 1pt per $1). */
  pointsPerCurrency  Int              @default(1)
  /** Points required for one reward. */
  rewardThreshold    Int              @default(100)
  /** Reward value in cents. */
  rewardCents        Int              @default(1000)
  accounts           LoyaltyAccount[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model LoyaltyAccount {
  id          String               @id @default(cuid())
  programId   String
  program     LoyaltyProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  customerId  String               @unique
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /** Cached balance; ledger is source of truth. */
  balance     Int                  @default(0)
  transactions LoyaltyTransaction[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([programId])
}

model LoyaltyTransaction {
  id          String         @id @default(cuid())
  accountId   String
  account     LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        LoyaltyTxnType
  points      Int
  orderId     String?
  note        String?
  createdAt   DateTime       @default(now())

  @@unique([accountId, type, orderId])
  @@index([accountId, createdAt])
}

model Review {
  id           String       @id @default(cuid())
  ownerId      String
  owner        Owner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId      String
  orderItemId  String?
  productId    String?
  rating       Int
  title        String?
  body         String
  status       ReviewStatus @default(PENDING)
  token        String       @unique
  sellerReply  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([orderId, productId])
  @@index([ownerId, status])
  @@index([productId, status])
}

model GiftCard {
  id            String               @id @default(cuid())
  ownerId       String
  owner         Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  code          String
  /** Initial face value cents. */
  initialCents  Int
  /** Cached remaining; ledger is source of truth. */
  balanceCents  Int
  currency      String               @default("AUD")
  customerId    String?
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  expiresAt     DateTime?
  isActive      Boolean              @default(true)
  note          String?
  transactions  GiftCardTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([ownerId, code])
  @@index([ownerId, isActive])
}

model GiftCardTransaction {
  id         String          @id @default(cuid())
  giftCardId String
  giftCard   GiftCard        @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type       GiftCardTxnType
  amountCents Int
  orderId    String?
  note       String?
  createdAt  DateTime        @default(now())

  @@index([giftCardId, createdAt])
}

// --- Phase 8: Advanced Operations ---

enum CustomOrderRequestStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  DECLINED
  CONVERTED
  CANCELLED
}

enum CustomOrderFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  SELECT
  DATE
}

enum SellerEventStatus {
  DRAFT
  LIVE
  CLOSED
}

model CustomOrderForm {
  id          String               @id @default(cuid())
  ownerId     String
  owner       Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  isPublished Boolean              @default(false)
  thankYouNote String?
  fields      CustomOrderField[]
  requests    CustomOrderRequest[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId, isPublished])
}

model CustomOrderField {
  id         String               @id @default(cuid())
  formId     String
  form       CustomOrderForm      @relation(fields: [formId], references: [id], onDelete: Cascade)
  label      String
  fieldType  CustomOrderFieldType @default(TEXT)
  required   Boolean              @default(false)
  sortOrder  Int                  @default(0)
  /** SELECT options as string[]. */
  options    Json?
  createdAt  DateTime             @default(now())

  @@index([formId, sortOrder])
}

model CustomOrderRequest {
  id            String                   @id @default(cuid())
  ownerId       String
  owner         Owner                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  formId        String
  form          CustomOrderForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  status        CustomOrderRequestStatus @default(SUBMITTED)
  customerName  String?
  email         String?
  phone         String?
  /** Field id → answer value. */
  answers       Json
  sellerNotes   String?
  convertedOrder Order?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([ownerId, status, createdAt])
  @@index([formId, createdAt])
}

model SellerEvent {
  id            String              @id @default(cuid())
  ownerId       String
  owner         Owner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  standId       String
  stand         Stand               @relation(fields: [standId], references: [id], onDelete: Cascade)
  name          String
  locationLabel String?
  startsAt      DateTime
  endsAt        DateTime?
  status        SellerEventStatus   @default(DRAFT)
  notes         String?
  products      SellerEventProduct[]
  orders        Order[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([ownerId, startsAt])
  @@index([standId, status])
}

model SellerEventProduct {
  id           String      @id @default(cuid())
  eventId      String
  event        SellerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /** Soft allocation for packing/close-out — not a stock reservation. */
  allocatedQty Int?
  soldQty      Int         @default(0)

  @@unique([eventId, productId])
  @@index([productId])
}

