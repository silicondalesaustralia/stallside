generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
}

enum PaymentMethod {
  CASH
  LOCAL_TRANSFER
  CARD
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PAID
  CUSTOMER_CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
  /** Deposit captured; balance still owed. */
  DEPOSIT_PAID
  /** Balance charge scheduled / due. */
  BALANCE_DUE
  /** Off-session balance charge failed (dunning). */
  BALANCE_FAILED
}

enum ReceiptChannel {
  NONE
  EMAIL
}

enum SubStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum InventorySource {
  OWNER_MANUAL
  ORDER_CASH
  ORDER_LOCAL_TRANSFER
  ORDER_CARD
  ORDER_PAYPAL
  SYSTEM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  NONE
}

enum GalleryStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum GallerySource {
  ADMIN
  OWNER_SUBMIT
}

enum CollectionStatus {
  ORDERED
  READY
  COLLECTED
}

/** When money moves relative to goods. */
enum PaymentTiming {
  PAY_NOW
  PAY_UPFRONT
  DEPOSIT_THEN_BALANCE
}

/** How goods reach the buyer. */
enum HandoverMode {
  COLLECT
  DELIVER
}

/** Cadence for owner-built shopper subscriptions (Connect Billing). */
enum ShopperSubInterval {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ShopperSubStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(OWNER)
  accounts      Account[]
  sessions      Session[]
  owner         Owner?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/** Pending name from frictionless signup until OTP creates the User */
model SignupIntent {
  email       String   @id
  name        String
  /** Free for Life invite token, if signing up via /invite/[token] */
  inviteToken String?
  /** Meta/Google click ids + UTMs captured at signup (fbclid etc). */
  adAttribution Json?
  createdAt   DateTime @default(now())
}

/** Free for Life invite links (admin-created). maxUses=1 for DMs, higher for group posts. */
model LifetimeInvite {
  id          String                     @id @default(cuid())
  token       String                     @unique
  note        String?
  maxUses     Int                        @default(1)
  useCount    Int                        @default(0)
  createdAt   DateTime                   @default(now())
  redemptions LifetimeInviteRedemption[]
}

model LifetimeInviteRedemption {
  id        String         @id @default(cuid())
  inviteId  String
  invite    LifetimeInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  email     String
  userId    String?
  createdAt DateTime       @default(now())

  @@unique([inviteId, email])
  @@index([inviteId])
}

/** Card / PayPal plan interest from landing waitlist */
model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  plan      String   @default("card_paypal")
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Owner {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName              String
  contactEmail              String
  contactPhone              String?
  stripeAccountId           String?
  stripeOnboardingComplete  Boolean            @default(false)
  stripeChargesEnabled      Boolean            @default(false)
  stripePayoutsEnabled      Boolean            @default(false)
  /** Platform Billing customer (Vendl SaaS subscription) */
  stripeCustomerId          String?
  /** Platform Billing subscription id */
  stripeSubscriptionId      String?
  paypalMerchantId          String?
  paypalOnboardingComplete  Boolean            @default(false)
  paypalPaymentsEnabled     Boolean            @default(false)
  emailAlertsEnabled        Boolean            @default(true)
  pushAlertsEnabled         Boolean            @default(true)
  alertEmails               String[]           @default([])
  subscriptionStatus        SubscriptionStatus @default(NONE)
  /** free | pro | pro_paypal - legacy starter/cash/card values accepted. */
  subscriptionPlan          String?            @default("free")
  /** Free Pro forever (invite or admin grant). */
  lifetimeAccess            Boolean            @default(false)
  monthlyFeeCents           Int                @default(0)
  /** Free plan: pass Vendl card fee to customer (default absorb). */
  passFeeToCustomer         Boolean            @default(false)
  /** Currency of the SaaS subscription (AUD/USD/GBP/EUR) */
  billingCurrency           String             @default("AUD")
  /** Sum of paid SaaS invoices (platform Billing), in invoice currency units */
  lifetimePaidCents         Int                @default(0)
  subscriptionStartedAt     DateTime?
  /** App-managed trial end (no card until they subscribe) */
  trialEndsAt               DateTime?
  /** Day 30 trial-ended email (lifecycle sequence) */
  trialReminderSentAt       DateTime?
  trialWelcomeSentAt        DateTime?
  trialDay7SentAt           DateTime?
  trialDay14SentAt          DateTime?
  trialDay23SentAt          DateTime?
  trialDay28SentAt          DateTime?
  trialDay45SentAt          DateTime?
  /** When paid Pro last fully lapsed to Starter (anchor for lapse emails). */
  proLapsedAt               DateTime?
  /** Pro cancel/lapse sequence (day 0 / 23 / 45). */
  proLapseDay0SentAt        DateTime?
  proLapseDay23SentAt       DateTime?
  proLapseDay45SentAt       DateTime?
  cashWelcomeSentAt         DateTime?
  cashSubscribedAt          DateTime?
  cashUpgradeDay2SentAt     DateTime?
  cashUpgradeDay7SentAt     DateTime?
  cashUpgradeDay14SentAt    DateTime?
  /** Pro welcome after paid subscribe (legacy name cardWelcomeSentAt). */
  cardWelcomeSentAt         DateTime?
  firstTenOrdersEmailSentAt DateTime?
  /** Cancellation / leave feedback email (portal cancel or delete). */
  cancelFeedbackSentAt      DateTime?
  /** Access continues until this time after cancel-at-period-end */
  currentPeriodEndsAt       DateTime?
  cancelAtPeriodEnd         Boolean            @default(false)
  platformFeePercentBps     Int                @default(200)
  stands                    Stand[]
  products                  Product[]
  preOrderPages             PreOrderPage[]
  subscriptionOffers        SubscriptionOffer[]
  shopperSubscriptions      ShopperSubscription[]
  orders                    Order[]
  inventoryAdjustments      InventoryAdjustment[]
  lowStockAlerts            LowStockAlert[]
  pushDevices               PushDevice[]
  galleryStands             GalleryStand[]
  /** Soft-close: data retained, login/emails/stands stopped. */
  deletedAt                 DateTime?
  /** Ad click ids + UTMs from first signup (for Perform/Meta pushback). */
  adAttribution             Json?
  /** First catalogue product went live (signup→live timing). */
  firstProductLiveAt        DateTime?
  /** Stall→pre-orders contextual cross-sell dismissed. */
  preOrdersCrossSellDismissedAt DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([deletedAt])
}

/** Public stand gallery - admin-curated + owner submissions */
model GalleryStand {
  id          String        @id @default(cuid())
  displayName String
  location    String
  imageUrl    String
  caption     String?
  source      GallerySource
  status      GalleryStatus @default(PENDING)
  sortOrder   Int           @default(100)
  ownerId     String?
  owner       Owner?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  standId     String?
  consentAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model PushDevice {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Stand {
  id                 String               @id @default(cuid())
  ownerId            String
  owner              Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  slug               String               @unique
  description        String?
  locationLabel      String?
  qrSignMessage      String?
  qrCallout          String?
  currency           String               @default("AUD")
  /** PayID / Pix / UPI alias shown at checkout (owner-direct; not verified). */
  localTransferAlias String?
  localTransferMethodId String?
  /** Per-stand checkout method toggles (still need owner Connect for card/PayPal). */
  acceptCash         Boolean              @default(true)
  acceptLocalTransfer Boolean             @default(true)
  acceptCard         Boolean              @default(true)
  acceptPayPal       Boolean              @default(false)
  showExactStock     Boolean              @default(false)
  /** Show “Only N left” when stock ≤ lowStockThreshold (public). */
  showPublicScarcity Boolean              @default(true)
  isActive           Boolean              @default(true)
  /** Stand-level cart upsell product (optional) - take-now carts. */
  upsellProductId    String?
  /** Optional override price when added via upsell card. */
  upsellPriceCents   Int?
  /** Pre-order cart add-on (name + price); linked hidden product. */
  preOrderUpsellName String?
  preOrderUpsellPriceCents Int?
  /** PERCENT | AMOUNT - off the list price for customer display. */
  preOrderUpsellDiscountKind String?
  /** Percent 1–100, or cents off when AMOUNT. */
  preOrderUpsellDiscountValue Int?
  preOrderUpsellProductId String?
  firstOrderDiscountEnabled Boolean        @default(false)
  /** Percent off first order (used when amount cents unset). */
  firstOrderDiscountPercent Int            @default(10)
  /** Fixed amount off; if set, wins over percent. */
  firstOrderDiscountAmountCents Int?
  posterShowCta      Boolean              @default(true)
  posterCtaText      String?
  posterShowBundles  Boolean              @default(true)
  posterShowFirstOrder Boolean            @default(true)
  posterShowInstructions Boolean          @default(true)
  posterShowFreshness Boolean             @default(false)
  posterShowHowItWorks Boolean            @default(false)
  /** Owner logo for public stall + QR poster (Pro). */
  logoUrl            String?
  /** Hex accent e.g. #2e7d3f - overrides --leaf on public stall + QR. */
  accentColor        String?
  /** Hex secondary for prices / stock labels - overrides --ok. */
  secondaryColor     String?
  /** Optional social / website links shown on the public stall (Pro). */
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  youtubeUrl         String?
  websiteUrl         String?
  /** Vertical config key: bakers | farm-stalls | firewood | … */
  verticalSlug       String?
  products           Product[]
  preOrderPages      PreOrderPage[]
  subscriptionOffers SubscriptionOffer[]
  shopperSubscriptions ShopperSubscription[]
  orders             Order[]
  inventoryAdjustments InventoryAdjustment[]
  lowStockAlerts     LowStockAlert[]
  restockSubscribers RestockSubscriber[]
  restockNotifications RestockNotification[]
  cardInterests      CardInterest[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

/** Starter checkout: shopper tapped "I'd have paid by card" (no PII). */
model CardInterest {
  id            String   @id @default(cuid())
  standId       String
  stand         Stand    @relation(fields: [standId], references: [id], onDelete: Cascade)
  subtotalCents Int
  currency      String
  createdAt     DateTime @default(now())

  @@index([standId, createdAt])
}

model Product {
  id                 String               @id @default(cuid())
  standId            String
  stand              Stand                @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  /** URL segment under /s/{standSlug}/{slug}; unique per stand. */
  slug               String
  description        String?
  imageUrl           String?
  seoTitle           String?
  seoDescription     String?
  priceCents         Int
  /** Owner-only unit cost; profit = priceCents - costCents when set. */
  costCents          Int?
  /** Owner-only stock-keeping unit. */
  sku                String?
  /** Owner-only barcode / UPC. */
  upc                String?
  currency           String               @default("AUD")
  stockQuantity      Int                  @default(0)
  lowStockThreshold  Int                  @default(5)
  /** Legacy soft-off; kept in sync with isArchived for older queries. */
  isActive           Boolean              @default(true)
  /** Hidden from stand catalog; direct link + checkout still work. */
  isHidden           Boolean              @default(false)
  /** Archived from selling; restorable. Not shown publicly. */
  isArchived         Boolean              @default(false)
  sortOrder          Int                  @default(0)
  /** Card-tier pay-upfront pre-order; stockQuantity is the cap. Synced from pre-order pages. */
  isPreOrder         Boolean              @default(false)
  /** Owner opted this catalogue product into pre-order pages. */
  preOrderEligible   Boolean              @default(false)
  orderByAt          DateTime?
  collectionAt       DateTime?
  collectionNote     String?
  /** When pre-order: show remaining slots publicly (e.g. "3 left"). */
  showExactStock     Boolean              @default(false)
  /** Defaults for new pre-order checkouts from this product. */
  paymentTiming      PaymentTiming        @default(PAY_NOW)
  /** 1–99 when paymentTiming is DEPOSIT_THEN_BALANCE. */
  depositPercent     Int?
  handoverMode       HandoverMode         @default(COLLECT)
  /** Optional provenance line e.g. "Laid this morning". */
  freshnessNote      String?
  /** Cart upsell offered when this product is in the cart (overrides stand-level). */
  upsellProductId    String?
  /** Optional override price when added via this product's upsell. */
  upsellPriceCents   Int?
  /** Pre-order add-on for carts that include this product. */
  preOrderUpsellName String?
  preOrderUpsellPriceCents Int?
  preOrderUpsellDiscountKind String?
  preOrderUpsellDiscountValue Int?
  preOrderUpsellProductId String?
  /** Exact-qty totals: [{ "qty": 2, "totalCents": 900 }, ...] — XOR with optionGroups. */
  priceTiers         Json?
  optionGroups       ProductOptionGroup[]
  preOrderPageItems  PreOrderPageProduct[]
  subscriptionOfferItems SubscriptionOfferProduct[]
  orderItems         OrderItem[]
  inventoryAdjustments InventoryAdjustment[]
  lowStockAlerts     LowStockAlert[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([standId, slug])
  @@index([standId, isActive])
}

/** Recurring box / membership basket built from catalog products. */
model SubscriptionOffer {
  id                 String                     @id @default(cuid())
  standId            String
  stand              Stand                      @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              Owner                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title              String
  slug               String
  description        String?
  isActive           Boolean                    @default(true)
  interval           ShopperSubInterval         @default(WEEKLY)
  handoverMode       HandoverMode               @default(COLLECT)
  /** 0=Sun … 6=Sat; next collection weekday for COLLECT. */
  collectionWeekday  Int?
  collectionNote     String?
  /** Snapshot total of line prices (qty × product.priceCents). */
  priceCents         Int
  currency           String                     @default("AUD")
  /** Stripe Product on the connected account. */
  stripeProductId    String?
  /** Stripe Price on the connected account (recurring). */
  stripePriceId      String?
  items              SubscriptionOfferProduct[]
  subscriptions      ShopperSubscription[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([standId, slug])
  @@index([standId, isActive])
}

model SubscriptionOfferProduct {
  id                 String            @id @default(cuid())
  subscriptionOfferId String
  subscriptionOffer  SubscriptionOffer @relation(fields: [subscriptionOfferId], references: [id], onDelete: Cascade)
  productId          String
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity           Int               @default(1)
  sortOrder          Int               @default(0)

  @@unique([subscriptionOfferId, productId])
  @@index([productId])
}

/** Shopper enrolled in an offer; Stripe Customer/Sub live on Connect account. */
model ShopperSubscription {
  id                     String            @id @default(cuid())
  offerId                String
  offer                  SubscriptionOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  standId                String
  stand                  Stand             @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId                String
  owner                  Owner             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status                 ShopperSubStatus  @default(INCOMPLETE)
  customerName           String
  customerEmail          String
  customerPhone          String?
  deliveryAddressLine1   String?
  deliverySuburb         String?
  deliveryPostcode       String?
  deliveryNotes          String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  /** Opaque token for manage / portal / skip / pause links. */
  manageToken            String            @unique
  skipNextCycle          Boolean           @default(false)
  pausedAt               DateTime?
  cancelAtPeriodEnd      Boolean           @default(false)
  currentPeriodEndsAt    DateTime?
  nextCollectionAt       DateTime?
  orders                 Order[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([stripeSubscriptionId])
  @@index([standId, status])
  @@index([ownerId, createdAt])
  @@index([offerId])
}

/** Multi-product pre-order sheet: one link, shared collection day. */
model PreOrderPage {
  id               String               @id @default(cuid())
  standId          String
  stand            Stand                @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  slug             String
  description      String?
  isActive         Boolean              @default(true)
  /** When true, page products stay off the business catalog and business QR. */
  hideOnBusinessPage Boolean            @default(true)
  orderByAt        DateTime
  collectionAt     DateTime
  collectionNote   String?
  showExactStock   Boolean              @default(false)
  paymentTiming    PaymentTiming        @default(PAY_UPFRONT)
  depositPercent   Int?
  handoverMode     HandoverMode         @default(COLLECT)
  /** Page-level cart add-on for this pre-order sheet. */
  preOrderUpsellName String?
  preOrderUpsellPriceCents Int?
  preOrderUpsellDiscountKind String?
  preOrderUpsellDiscountValue Int?
  preOrderUpsellProductId String?
  items            PreOrderPageProduct[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([standId, slug])
  @@index([standId, isActive])
}

model PreOrderPageProduct {
  id             String       @id @default(cuid())
  preOrderPageId String
  preOrderPage   PreOrderPage @relation(fields: [preOrderPageId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)

  @@unique([preOrderPageId, productId])
  @@index([productId])
}

/** Named option group on a product (e.g. Size, Flavour). Max 3 per product in app. */
model ProductOptionGroup {
  id        String                @id @default(cuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int                   @default(0)
  choices   ProductOptionChoice[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([productId, sortOrder])
}

model ProductOptionChoice {
  id              String             @id @default(cuid())
  groupId         String
  group           ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  /** Added to product base price (can be 0 or positive). */
  priceDeltaCents Int                @default(0)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([groupId, sortOrder])
}

model Order {
  id                      String            @id @default(cuid())
  standId                 String
  stand                   Stand             @relation(fields: [standId], references: [id], onDelete: Cascade)
  ownerId                 String
  owner                   Owner             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orderNumber             String            @unique
  paymentMethod           PaymentMethod
  paymentStatus           PaymentStatus
  /** payid | pix | upi when paymentMethod is LOCAL_TRANSFER */
  localTransferMethodId   String?
  subtotalCents           Int
  totalCents              Int
  /** First-order (or other) discount applied to this order. */
  discountCents           Int               @default(0)
  discountLabel           String?
  currency                String
  platformFeeCents        Int               @default(0)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paypalOrderId           String?
  paypalCaptureId         String?
  receiptEmail            String?
  receiptChannel          ReceiptChannel    @default(NONE)
  isPreOrder              Boolean           @default(false)
  collectionAt            DateTime?
  collectionNote          String?
  customerName            String?
  customerPhone           String?
  collectionStatus        CollectionStatus?
  paymentTiming           PaymentTiming     @default(PAY_NOW)
  handoverMode            HandoverMode      @default(COLLECT)
  /** Amount charged as deposit (cents). */
  depositCents            Int?
  /** Remaining balance owed (cents). */
  balanceCents            Int?
  /** When to charge the balance (usually delivery/collection day). */
  balanceDueAt            DateTime?
  /** Saved card on connected account for off-session balance. */
  stripePaymentMethodId   String?
  balancePaymentIntentId  String?
  /** Off-session balance charge attempts (dunning). */
  balanceRetryCount       Int               @default(0)
  balanceLastFailedAt     DateTime?
  deliveryAddressLine1    String?
  deliverySuburb          String?
  deliveryPostcode        String?
  deliveryNotes           String?
  /** Set when this order was created from a shopper subscription invoice. */
  shopperSubscriptionId   String?
  shopperSubscription     ShopperSubscription? @relation(fields: [shopperSubscriptionId], references: [id], onDelete: SetNull)
  /** Connect invoice id — idempotency for subscription cycle orders. */
  stripeInvoiceId         String?           @unique
  items                   OrderItem[]
  inventoryAdjustments    InventoryAdjustment[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([ownerId, createdAt])
  @@index([standId, createdAt])
  @@index([standId, collectionAt, collectionStatus])
  @@index([paymentStatus, balanceDueAt])
  @@index([shopperSubscriptionId])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productNameSnapshot String
  /** e.g. "Size: Dozen · Flavour: Chocolate" */
  optionsSnapshot     String?
  quantity            Int
  unitPriceCents      Int
  lineTotalCents      Int
  createdAt           DateTime @default(now())
}

model InventoryAdjustment {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  standId          String
  stand            Stand           @relation(fields: [standId], references: [id], onDelete: Cascade)
  changeQuantity   Int
  previousQuantity Int
  newQuantity      Int
  reason           String
  source           InventorySource
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([productId, createdAt])
}

model LowStockAlert {
  id                   String   @id @default(cuid())
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ownerId              String
  owner                Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  standId              String
  stand                Stand    @relation(fields: [standId], references: [id], onDelete: Cascade)
  stockQuantityAtAlert Int
  threshold            Int
  channel              String   @default("email")
  sentAt               DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([productId, sentAt])
}

model RestockSubscriber {
  id             String    @id @default(cuid())
  standId        String
  stand          Stand     @relation(fields: [standId], references: [id], onDelete: Cascade)
  email          String
  status         SubStatus @default(ACTIVE)
  consentText    String
  consentAt      DateTime  @default(now())
  consentSource  String
  unsubToken     String    @unique
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([standId, email])
  @@index([standId, status])
}

model RestockNotification {
  id             String   @id @default(cuid())
  standId        String
  stand          Stand    @relation(fields: [standId], references: [id], onDelete: Cascade)
  sentByUserId   String
  recipientCount Int
  sentAt         DateTime @default(now())

  @@index([standId, sentAt])
}

/** Audit log for outbound emails (Resend + local console fallback). */
model EmailSendLog {
  id        String   @id @default(cuid())
  /** Lowercased recipient addresses */
  toEmails  String[]
  subject   String
  /** e.g. otp, sale, lifecycle_welcome, restock, waitlist */
  kind      String?
  /** sent | failed | console */
  status    String
  resendId  String?
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}
