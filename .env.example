# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# After wildcard DNS/TLS is proven on production, set to "1" so seller links use {slug}.vendl.app
# NEXT_PUBLIC_STOREFRONT_SUBDOMAIN_PRIMARY="1"
# Staging Preview: force staging host mode (also inferred from NEXT_PUBLIC_APP_URL containing staging.vendl.app)
# VENDL_HOST_ENV="staging"
# NEXT_PUBLIC_APP_URL="https://staging.vendl.app"
# Capacitor owner shell loads this URL (defaults to NEXT_PUBLIC_APP_URL)
# CAPACITOR_SERVER_URL="https://vendl.app"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Local: http://localhost:3000 - Production (Vercel): https://vendl.app
AUTH_URL="http://localhost:3000"

# Database
# Runtime: Neon pooled URL is fine for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vendl?schema=public&sslmode=verify-full"
# Migrations: set this to Neon’s *direct* (non-pooler) connection string in Vercel.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-....neon.tech/neondb?sslmode=require"

# Email (optional locally - magic links + sale/low-stock alerts log to console)
# RESEND_API_KEY=""
# EMAIL_FROM="Vendl <hello@vendl.app>"
# Optional extra recipient for contact/waitlist/admin alerts
# (always also sends to hello@vendl.app and jono@silicondales.com)
# CONTACT_EMAIL="other@example.com"

# iOS push via APNs (Capacitor on iPhone - no Firebase required)
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID="com.myfarmstand.owner"
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_USE_SANDBOX="true"

# Android push (optional - FCM)
# FCM_SERVER_KEY="AAAA..."

# Browser / PWA web push (owner phone alerts - home screen install)
# Generate: npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# Stripe - one platform account, two uses:
# 1) Billing: owners pay Vendl (SaaS subscription) - Price IDs per currency
# 2) Connect: owners receive stand customer payments (Express + Checkout)
STRIPE_SECRET_KEY="sk_test_..."
# Optional: keep live platform key above, and use test keys only for /demo Card checkout
# STRIPE_SECRET_KEY_TEST="sk_test_..."
# Test-mode Connect account id for demo Card (acct_…) - required when STRIPE_SECRET_KEY is sk_live_
# DEMO_STRIPE_ACCOUNT_ID="acct_..."
# Public demo stands (two stands under admin owner - USA also serves Rest of world)
# Names: "Green Valley Eggs Australia" / "Green Valley Eggs USA"
# DEMO_STALL_STAND_SLUG="your-stall-demo-slug"
# DEMO_PREORDER_STAND_SLUG="green-valley-baked-goods"
# DEMO_PREORDER_PAGE_SLUG="pre-order-bread-27-may-2027"
# Website Studio public demos (Green Valley Farm & Bakes)
# DEMO_WEBSITE_STAND_SLUG="green-valley-farm-bakes"
# DEMO_WEBSITE_STOREFRONT_SLUG="green-valley-farm-bakes"
# Your account destination (SaaS billing subscriptions / invoices)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Connected accounts destination (Tap & Go Checkout + account.updated) - same URL
# STRIPE_WEBHOOK_SECRET_CONNECT="whsec_..."
# Optional test-mode webhook secrets (same URL) for demo Card fulfillment
# STRIPE_WEBHOOK_SECRET_TEST="whsec_..."
# STRIPE_WEBHOOK_SECRET_TEST_CONNECT="whsec_..."
# Vendl Pro Prices (preferred). List: AUD 19.99 / USD 14.99 / GBP 11.99 / EUR 14.99
# Product: Vendl Pro (e.g. prod_Ut4WORakgeAPFA)
STRIPE_PRICE_ID_PRO_AUD="price_..."
STRIPE_PRICE_ID_PRO_USD="price_..."
STRIPE_PRICE_ID_PRO_GBP="price_..."
STRIPE_PRICE_ID_PRO_EUR="price_..."
# Legacy Card env names - still resolved if PRO_* unset
# STRIPE_PRICE_ID_CARD_AUD="price_..."
# STRIPE_PRICE_ID_CARD_USD="price_..."
# STRIPE_PRICE_ID_CARD_GBP="price_..."
# STRIPE_PRICE_ID_CARD_EUR="price_..."
# Legacy Cash Prices - keep until all Cash subscribers migrated (Starter is free; Cash no longer sold)
# STRIPE_PRICE_ID_CASH_AUD="price_..."
# STRIPE_PRICE_ID_CASH_USD="price_..."
# STRIPE_PRICE_ID_CASH_GBP="price_..."
# STRIPE_PRICE_ID_CASH_EUR="price_..."
# STRIPE_PRICE_ID_CASH="price_..."
# Also enable Customer Portal in Stripe Dashboard → Settings → Billing → Customer portal
# Webhook events (platform + Connect): checkout.session.completed,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   checkout.session.expired, account.updated,
#   customer.subscription.updated, customer.subscription.deleted, invoice.paid,
#   invoice.payment_failed
# Connect webhooks also cover shopper subscriptions (purpose=shopper_subscription).
# Apple Pay: enable in Stripe Dashboard → Payment methods; verify vendl.app
#   (test + live). Google Pay: confirm enabled. Wallets appear on Checkout automatically.
# Cron (Vercel daily lifecycle emails → /api/cron/trial-reminders)
# CRON_SECRET="generate-a-long-random-string"
# Stand gallery image uploads (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=""
# PayPal multiparty (Partner Referrals) + Venmo (USD funding source)
# Ops checklist before production:
#   1. PayPal Marketplace / Partner Referrals approved on the live app
#   2. Live Client ID/Secret + partner merchant id + BN code
#   3. Webhook registered: https://vendl.app/api/paypal/webhook
#      Events: PAYMENT.CAPTURE.COMPLETED, CHECKOUT.ORDER.APPROVED, CHECKOUT.ORDER.COMPLETED
#   4. Sandbox QA (connect → stand toggle → checkout → capture) then set ENABLED=1
# Client ID is also passed to the browser for the official PayPal Buttons SDK
# Sandbox: PAYPAL_MODE=sandbox + sandbox Client ID/Secret + sandbox partner merchant id
# Live:    PAYPAL_MODE=live   + live Client ID/Secret + live partner merchant id
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_PARTNER_MERCHANT_ID=""
# PAYPAL_BN_CODE=""
# PAYPAL_MODE="sandbox"
# Set to 1 when Partner Referrals is approved and Connect is ready (sandbox or live).
# Leave unset (or 0) for Coming soon everywhere.
# PAYPAL_CONNECT_ENABLED="1"
# Sandbox without Partner API: PAYPAL_CONNECT_MODE="direct" (platform receives funds).
# Production marketplace: omit PAYPAL_CONNECT_MODE (or set marketplace) after Partner approval.
# PAYPAL_CONNECT_MODE="direct"
# Optional override of merchant id for direct checkout (defaults to PARTNER_MERCHANT_ID):
# PAYPAL_DIRECT_MERCHANT_ID=""
# PAYPAL_WEBHOOK_ID=""
# After switching sandbox → live: owners must Connect PayPal again (live Business account).

# --- Phase 9: Cloudflare for SaaS custom domains (server-only; leave off until spike) ---
