# ── Social kit env vars (Vercel: Production + Preview) ─────────────────────
# Values marked [same as StitchedUp] can be copied from the StitchedUp/TradiesPost
# Vercel project. Never commit real values.

# Host
NEXT_PUBLIC_APP_URL=https://www.vendl.app          # canonical origin, no trailing slash
SOCIAL_PUBLIC_ORIGIN=                              # optional override of the above for OAuth/media URLs
CRON_SECRET=                                       # Vendl's existing cron secret is fine

# Social Supabase project (NEW project, see HANDOFF.md step 1)
NEXT_PUBLIC_SUPABASE_URL=https://<new-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                         # server only - never expose

# AI
OPENAI_API_KEY=                                    # [same as StitchedUp] images + captions
OPENAI_IMAGE_MODEL=                                # optional, defaults in code
OPENAI_EDIT_IMAGE_MODEL=                           # optional
OPENAI_EXPAND_MODEL=                               # optional
SOCIAL_IMAGE_QUALITY=high                          # high | medium
AI_LLM_PROVIDER=anthropic                          # anthropic | openai | openrouter
AI_LLM_MODEL=claude-haiku-4-5-20251001
AI_LLM_MODEL_EXTRACTION=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=                                 # [same as StitchedUp]
OPENROUTER_API_KEY=                                # optional

# Design + stock images
ORSHOT_API_KEY=                                    # [same as StitchedUp] designed templates
UNSPLASH_ACCESS_KEY=                               # [same as StitchedUp]
PEXELS_API_KEY=                                    # [same as StitchedUp]
INFOGRAPHIC_AI_BACKGROUND_ENABLED=false

# Meta (Facebook + Instagram) - same app, add Vendl redirect URI
META_CONNECT_ENABLED=true
META_APP_ID=                                       # [same as StitchedUp]
META_APP_SECRET=                                   # [same as StitchedUp]

# Google Business Profile - same OAuth client, add Vendl redirect URI
GMB_CONNECT_ENABLED=true
GOOGLE_GMB_CLIENT_ID=                              # [same as StitchedUp]
GOOGLE_GMB_CLIENT_SECRET=                          # [same as StitchedUp]
GOOGLE_GMB_REDIRECT_URI=                           # optional; default {origin}/api/social/connect/gmb/callback
GBP_PERFORMANCE_ENABLED=true
GBP_PERFORMANCE_DEMO_MODE=false

# TikTok - same app, add Vendl redirect URI + URL prefix
TIKTOK_CONNECT_ENABLED=true
TIKTOK_CLIENT_KEY=                                 # [same as StitchedUp]
TIKTOK_CLIENT_SECRET=                              # [same as StitchedUp] (rotate before handing over)

# YouTube - same Google OAuth client as StitchedUp ("StitchedUp GMB"); add Vendl redirect URI
YOUTUBE_CONNECT_ENABLED=true
GOOGLE_YOUTUBE_CLIENT_ID=                          # [same as StitchedUp]
GOOGLE_YOUTUBE_CLIENT_SECRET=                      # [same as StitchedUp] (also the OAuth state HMAC key)

# Pinterest - Vendl app (developers.pinterest.com); redirect URI .../api/social/connect/pinterest/callback
PINTEREST_CONNECT_ENABLED=false                    # true once the app is approved
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=                              # also the OAuth state HMAC key
PINTEREST_API_BASE=                                # https://api-sandbox.pinterest.com while on Trial access
PINTEREST_SANDBOX_ACCESS_TOKEN=                    # sandbox token from the app page; only used with the sandbox base

# X - developer.x.com app > User authentication settings (Web App, confidential client, Read and write)
# Callback URI .../api/social/connect/x/callback. Uses the OAuth 2.0 Client ID/Secret, not the consumer key or bearer token.
X_CONNECT_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=                                   # also the OAuth state HMAC key

# Google Calendar sync (Vendl calendar <-> Google) - uses the YouTube client above
# unless a dedicated Calendar client is set here
GOOGLE_CALENDAR_CONNECT_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=                            # optional
GOOGLE_OAUTH_CLIENT_SECRET=                        # optional

# Demo mode (fake connections, no real posting) - keep false in production
SOCIAL_DEMO_MODE=false

# Cost estimation for ai_usage_events (optional)
USD_TO_AUD_RATE=
AI_COST_INPUT_USD_PER_1M=
AI_COST_OUTPUT_USD_PER_1M=

# ── Video clipping (Vercel AND worker) ──────────────────────────────────────
# Cloudflare R2 bucket for raw source uploads (7-day lifecycle rule; CORS PUT
# from the app origins, exposing ETag).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_VIDEO_SOURCES_BUCKET=

# ── Video worker (Render background worker, NOT Vercel) ────────────────────
# SUPABASE_URL=https://<new-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=                                  # Whisper transcription + moment picking
# VIDEO_PROCESSOR_POLL_MS=3000
# VIDEO_PROCESSOR_WORKER_ID=vendl-video-1
# VIDEO_CLIP_TRANSCRIBE_MODEL=                     # optional, defaults in code
# VIDEO_CLIP_LLM_MODEL=                            # optional, defaults in code
# VIDEO_CLIP_CONCURRENCY=                          # optional, parallel clip renders
# VIDEO_FFMPEG_THREADS=                            # optional
# VIDEO_SINGLE_PASS_CAPTIONS=                      # optional
