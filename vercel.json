{
  "buildCommand": "npm run build:vercel",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/balance-dunning",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/membership-collections",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/campaigns",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/square-reconcile",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/square-subscriptions",
      "schedule": "30 * * * *"
    },
    { "path": "/api/cron/publish-due-social-posts", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/tiktok-publish-status", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/process-week-plan-generation", "schedule": "* * * * *" },
    { "path": "/api/cron/inspiration-temp-cleanup", "schedule": "0 * * * *" },
    { "path": "/api/cron/media-asset-upload-cleanup", "schedule": "0 3 * * *" },
    { "path": "/api/cron/gbp-performance-sync", "schedule": "0 16 * * *" }
  ]
}
