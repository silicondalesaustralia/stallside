{
  "name": "myfarmstand",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-tinymce.js && prisma generate && next build",
    "build:vercel": "node scripts/copy-tinymce.js && prisma generate && node scripts/migrate-deploy-retry.js && next build",
    "start": "next start",
    "lint": "eslint",
    "test:tenancy": "npx tsx --test src/lib/tenancy/hostname.test.ts src/lib/domains/domains.test.ts",
    "test:production": "npx tsx --test src/lib/production/units-costing.test.ts src/lib/production/flatten-ingredients.test.ts",
    "test:grow": "npx tsx --test src/lib/grow/grow.test.ts",
    "test:ops": "npx tsx --test src/lib/ops/ops.test.ts",
    "test:calendar": "npx tsx --test src/lib/calendar/calendar.test.ts",
    "test:ia": "npx tsx --test src/lib/dash-ia.test.ts",
    "seed:green-valley-demo": "npx tsx scripts/seed-green-valley-demo.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/copy-tinymce.js",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "admin:promote": "npx tsx scripts/promote-admin.ts",
    "push:test": "npx tsx scripts/test-web-push.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@craftjs/core": "^0.2.12",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^7.0.2",
    "@fullcalendar/timegrid": "^6.1.21",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@puckeditor/core": "0.21.3",
    "@tinymce/tinymce-react": "^6.3.0",
    "@vercel/blob": "^2.6.1",
    "dotenv": "^17.4.2",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.1",
    "temporal-polyfill": "^1.0.4",
    "tinymce": "^8.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
